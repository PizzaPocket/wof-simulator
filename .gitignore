node_modules/
dist/
.vercel/
.DS_Store

# Downloaded source maps and generated map data
cache/
game/assets/maps/pyrrhia_reference.png
game/assets/maps/pyrrhia_reference.png.import
__pycache__/
*.glb

# Clay model: downloaded reference images and build output (never committed: the repo is public)
prototypes/clay/refs/
prototypes/clay/out/

# Godot imports, local editor state and exports
.godot/
game/exports/
game/assets/*.glb.import
game/assets/clay_rig.json

game/assets/dragons/*.glb.import
game/assets/scavengers/*.glb.import

# Generated by the build scripts (see docs/bare-terrain.md and docs/village-npcs.md)
# Terrain heightfields and streamed pages are about 150 MB and rebuild from
# data/terrain/world_regions.json with tools/map/build_terrain.py.
game/data/terrain/*.height
game/data/terrain/*.rgb
game/data/terrain/*_pages/
# Hair textures come from CC0/CC-BY MakeHuman packs fetched by fetch_hair_source.py.
game/assets/scavengers/*_hair-*.png
game/assets/scavengers/*_hair-*.png.import

# Local rendered terrain review evidence
.impeccable/review/
